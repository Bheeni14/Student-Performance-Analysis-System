# Student Performance Analysis System - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints

# Data files (generated)
data/*.csv
data/*.xlsx
!data/.gitkeep

# Visualizations (generated)
visualizations/*.png
visualizations/*.jpg
visualizations/*.pdf
!visualizations/.gitkeep

# Reports (generated)
reports/*.txt
reports/*.md
reports/*.pdf
!reports/.gitkeep

# OS
.DS_Store
Thumbs.db
*.log

# Streamlit
.streamlit/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
temp/
tmp/
